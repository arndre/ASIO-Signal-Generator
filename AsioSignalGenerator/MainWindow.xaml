<Window x:Class="AsioSignalGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASIO Signal Generator" Height="760" Width="1080" MinHeight="620" MinWidth="920"
        Background="#12121A" WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#1B1B27"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2C2C3D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFC"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#9678FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8E8F0"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8F8FA3"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF5C7A"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#FF7A94"/>
        <SolidColorBrush x:Key="InputBrush" Color="#24243480"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#20202E"/>
            <Setter Property="Foreground" Value="#20202E"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#20202E"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,14,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <!-- Rounded accent button -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A3A4A"/>
                                <Setter Property="Foreground" Value="#7A7A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A3A4A"/>
                                <Setter Property="Foreground" Value="#7A7A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#26263A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Grid.Column="0">
                <TextBlock Text="ASIO Signal Generator" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="NAudio · 48 kHz / 32-bit float pipeline" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="20" Padding="14,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#5A5A6A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Stopped" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column: controls -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Device -->
                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="ASIO DEVICE" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Driver" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="DeviceComboBox" SelectionChanged="DeviceComboBox_SelectionChanged" Margin="0,0,0,10"/>

                            <TextBlock Text="Sample Rate" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="SampleRateComboBox" SelectionChanged="SampleRateComboBox_SelectionChanged" Margin="0,0,0,4"/>
                            <TextBlock Text="Greyed-out rates are not supported by this driver." Style="{StaticResource Label}" FontStyle="Italic" Margin="0,0,0,10"/>

                            <TextBlock x:Name="FormatInfoText"
                                       Text="Internal pipeline: 32-bit float (IEEE 754). NAudio converts automatically to the driver's native bit depth."
                                       Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <UniformGrid Rows="1" Columns="2">
                                <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="RefreshDevicesButton_Click"/>
                                <Button Content="Control Panel..." Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="ControlPanelButton_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Signal -->
                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="SIGNAL GENERATOR" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="Waveform" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="WaveformComboBox" Margin="0,0,0,12" SelectionChanged="WaveformComboBox_SelectionChanged">
                                <ComboBoxItem Content="Sine Wave" Tag="Sine" IsSelected="True"/>
                                <ComboBoxItem Content="Square Wave" Tag="Square"/>
                                <ComboBoxItem Content="Triangle Wave" Tag="Triangle"/>
                                <ComboBoxItem Content="Sawtooth Wave" Tag="Sawtooth"/>
                                <ComboBoxItem Content="White Noise" Tag="WhiteNoise"/>
                                <ComboBoxItem Content="Pink Noise" Tag="PinkNoise"/>
                            </ComboBox>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Frequency" Style="{StaticResource Label}" Grid.Column="0"/>
                                <TextBlock x:Name="FrequencyValueText" Text="440 Hz" Style="{StaticResource Label}" Grid.Column="1" Foreground="{StaticResource TextBrush}"/>
                            </Grid>
                            <Slider x:Name="FrequencySlider" Minimum="20" Maximum="20000" Value="440"
                                    ValueChanged="FrequencySlider_ValueChanged" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FrequencyTextBox" Grid.Column="0" Text="440" VerticalAlignment="Center" Height="30"/>
                                <Button Grid.Column="2" Content="Set Hz" Style="{StaticResource GhostButton}" Click="FrequencyApplyButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Volume -->
                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="OUTPUT VOLUME" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gain" Style="{StaticResource Label}" Grid.Column="0"/>
                                <TextBlock x:Name="VolumeValueText" Text="-12.0 dB" Style="{StaticResource Label}" Grid.Column="1" Foreground="{StaticResource TextBrush}"/>
                            </Grid>
                            <Slider x:Name="VolumeSlider" Minimum="-60" Maximum="6" Value="-12"
                                    ValueChanged="VolumeSlider_ValueChanged" TickFrequency="1"/>
                        </StackPanel>
                    </Border>

                    <!-- Transport -->
                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="TRANSPORT" Style="{StaticResource SectionHeader}"/>
                            <UniformGrid Rows="1" Columns="2">
                                <Button x:Name="StartButton" Content="▶  Start" Style="{StaticResource AccentButton}" Margin="0,0,6,0" Click="StartButton_Click" Height="40"/>
                                <Button x:Name="StopButton" Content="■  Stop" Style="{StaticResource DangerButton}" Margin="6,0,0,0" Click="StopButton_Click" Height="40" IsEnabled="False"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Right column: channels + log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MaxHeight="220"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Output channels -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="OUTPUT CHANNELS" Style="{StaticResource SectionHeader}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                            <WrapPanel x:Name="ChannelsPanel"/>
                        </ScrollViewer>
                        <TextBlock x:Name="ChannelsHintText" Text="Select a driver to list its output channels."
                                   Style="{StaticResource Label}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Log -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LOG" Style="{StaticResource SectionHeader}" Grid.Column="0" Margin="0"/>
                            <Button Grid.Column="1" Content="Clear" Style="{StaticResource GhostButton}" Padding="10,4" Click="ClearLogButton_Click"/>
                        </Grid>
                        <ListBox x:Name="LogListBox" Grid.Row="1" Background="#15151F" Foreground="{StaticResource TextBrush}"
                                 BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
